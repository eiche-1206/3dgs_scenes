  <worldbody>
    <light pos="-4.32 -5.46 6" dir="0 0 -1" directional="true" diffuse="0.35 0.35 0.35"
           specular="0 0 0" castshadow="false"/>
    <!-- PERF: analytic collision floor. The robot's feet are in constant floor
         contact, and against the SDF tiles that is the dominant per-step cost
         (~200 gradient-descent evals per foot-vs-tile pair). A plane-vs-geom
         contact is analytic and nearly free, so this offloads foot-floor
         collision from the 60 SDF tiles, which are then only exercised by walls
         / furniture / protrusions the feet rarely touch. SDF fidelity is
         untouched (tiles/voxels unchanged) — this only removes redundant
         contacts.
         z = -0.14 sits ~1 cm above the measured SDF floor collision surface
         (z≈-0.15 across the walkable area, 91% within ±5 cm), so feet rest on
         the plane BEFORE reaching the SDF floor zero-surface → no double
         contact, and standing height matches the SDF-only baseline. Where the
         real floor rises above -0.14 (steps/platforms) the SDF still catches it.
         Invisible (group 3 + alpha 0): floor_backing already backs the visual.
         A/B: comment this geom out to revert to SDF-only floor collision. -->
    <geom name="floor" type="plane" pos="0 0 -0.14" size="60 45 0.1"
          group="3" rgba="0 0 0 0" contype="1" conaffinity="0" condim="3"
          friction="1 0.005 0.0001" solref="0.004 1" solimp="0.95 0.99 0.001"/>
    <!-- Visual backing floor: the scanned visual mesh has holes/cracks in its floor
         (grazing-angle coverage gaps + decimation), and with no plane behind, the light
         MuJoCo background showed through them as white tears. This opaque concrete-grey
         plane sits at z=-0.45, just below the scan floor (surface ~z=-0.24..-0.38, only
         0.2% of geometry is below -0.45), so intact floor still occludes it and only the
         holes reveal grey instead of white. Visual only (contype/conaffinity 0); the SDF
         tiles handle collision. -->
    <geom name="floor_backing" type="plane" pos="0 0 -0.45" size="60 45 0.1"
          rgba="0.42 0.42 0.44 1" group="0" contype="0" conaffinity="0"/>
